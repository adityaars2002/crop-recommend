# ==============================================================================
# Smart Agriculture System - Git Ignore
# ==============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# --- Virtual Environment ---
venv/
env/
.venv/
crop-disease-venv/

# --- Environment Secrets ---
.env

# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.env

# --- Django ---
*.sqlite3
db.sqlite3
staticfiles/
mediafiles/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- ML Artifacts (Crop Recommendation) ---
ml/artifacts/*.joblib
ml/artifacts/*.pkl
ml/artifacts/*.h5
# Do NOT ignore the production model and metadata
!ml/artifacts/crop_recommendation_model.joblib
!ml/artifacts/feature_metadata.json
!ml/artifacts/model_metadata.json
ml/evaluation/results/*.png

# --- ML Artifacts (Plant Disease Detection) ---
# Ignore experimental models
ml/disease/artifacts/exp_*.keras
# Do NOT ignore the final model — it is required for deployment
!ml/disease/artifacts/plant_disease_model.keras

# --- Data & Datasets (large files) ---
# Uncomment if you don't want to track raw data in git
# data/raw/
PlantVillage-Dataset-master/
PlantVillage-Dataset-master.zip
temp_plantvillage/
data/disease/raw/
data/disease/processed/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Misc ---
*.log
*.bak
*.tmp