# ==============================================================================
# Smart Agriculture System - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ==============================================================================

# Django Secret Key — generate a new one for production
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Debug mode — set to False in production
DEBUG=True

# Allowed hosts — comma-separated list
# For development: 127.0.0.1,localhost,10.0.2.2
# For Render: your-service-name.onrender.com
# (Render also sets RENDER_EXTERNAL_HOSTNAME automatically)
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# Database URL (optional — defaults to SQLite)
# For PostgreSQL on Render: postgres://user:password@host:port/dbname
# DATABASE_URL=

# CORS — comma-separated list of allowed origins
# For development, CORS_ALLOW_ALL_ORIGINS=True is used when DEBUG=True
# For production, set the deployed frontend URL:
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com

# CSRF trusted origins — required if frontend POSTs to the backend
# CSRF_TRUSTED_ORIGINS=https://your-frontend.onrender.com
